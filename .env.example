# Local development. npm run setup generates independent random secrets.
DATA_DIR=./data/local-preview
ADMIN_LOCAL_ONLY=1
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1,::1
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-64-random-characters
MAIL_SIGNUP_RATE_SECRET=replace-with-a-random-secret
MAIL_SIGNUP_ENABLED=0
MEDIA_ACCEL_REDIRECT=0
# Optional independent development mail server:
# STALWART_API_URL=http://127.0.0.1:8080/api
# STALWART_API_TOKEN=replace-with-a-scoped-server-side-token
# STALWART_DOMAIN_ID=replace-with-your-development-domain-id
# MAIL_IMAP_HOST=127.0.0.1
# MAIL_IMAP_PORT=993
# MAIL_IMAP_SERVERNAME=mail.example.org
